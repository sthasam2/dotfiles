// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "agent_ui_font_size": 13.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "language_models": {
    "openai_compatible": {
      "9Router": {
        "api_url": "http://localhost:20128/v1",
        "available_models": [
          {
            "name": "gemini/gemma-4-31b-it",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
          {
            "name": "gemini/gemini-3.5-flash",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
          {
            "name": "mmf/mimo-auto",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "project_panel": {
    "dock": "right",
  },
  "enable_language_server": true,
  "agent": {
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "google/gemma-4-31b-it:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "openai/gpt-oss-20b:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "google/gemma-4-26b-a4b-it:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-super-120b-a12b:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "google/gemini-3.1-flash-image-preview",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "google/gemini-3.1-flash-lite-preview",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "google/gemini-3-flash-preview",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-nano-9b-v2:free",
        "enable_thinking": true
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-nano-30b-a3b:free",
        "enable_thinking": true
      }
    ],
    "sidebar_side": "left",
    "default_profile": "write",
    "dock": "left",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    },
    "model_parameters": [],
  },
  "agent_servers": {
    "qwen-code": {
      "type": "registry"
    },
    "kimi": {
      "type": "registry"
    },
    "glm-acp-agent": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "gemini-custom": {
      "type": "custom",
      "command": "gemini",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "buffer_font_family": "Ubuntu Sans Mono",
  "ui_font_family": "Ubuntu Sans Mono",
  "minimap": {
    "show": "auto",
  },
  "cursor_blink": true,
  "base_keymap": "VSCode",
  "file_types": {
    "html": ["*.html"],
    "plaintext": ["*.txt"],
    "dotenv": [".env*"],
  },
  "linked_edits": true,
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": false,
  "ui_font_size": 14,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "GitHub Dark Dimmed",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
  },
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
      ],
    },
    "TypeScript": {
      "enable_language_server": true,
      "tab_size": 2,
      "language_servers": ["tsgo", "biome", "!typescript-language-server"],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JavaScript": {
      "enable_language_server": true,
      "tab_size": 2,
      "language_servers": ["tsgo", "biome", "!typescript-language-server"],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TSX": {
      "show_edit_predictions": false,
      "language_servers": [
        "tsgo",
        "biome",
        "typescript-language-server",
        "tailwindcss-intellisense-css",
      ],
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "Python": {
      "enable_language_server": true,
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "language_servers": ["ty", "ruff", "basedpyright"],
    },
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
  },
}
